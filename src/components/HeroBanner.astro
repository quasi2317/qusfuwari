---
import { siteConfig } from "../config";

interface Props {
	class?: string;
}

const { class: className } = Astro.props;
const showScrollIndicator = siteConfig.heroBanner?.showScrollIndicator ?? true;
const titleParts = siteConfig.title.split(/(?<=[a-z0-9])(?=[A-Z])/);
---

<section id="hero-banner" class:list={["hero-banner", className]}>
	<div class="hero-content">
		<h1 class="hero-title" aria-label={siteConfig.title} data-pagefind-ignore>
			{titleParts.map((part) => <span class="hero-title-part">{part}</span>)}
		</h1>
	</div>

	{showScrollIndicator && (
		<button
			type="button"
			class="hero-scroll-indicator"
			id="scroll-indicator"
			aria-label="向下滚动到文章"
		>
			<!-- 像素风双箭头（11×11 像素网格），与像素哥特体标题和像素背景保持一致 -->
			<svg
				class="scroll-chevrons"
				viewBox="0 0 11 11"
				fill="currentColor"
				shape-rendering="crispEdges"
				aria-hidden="true"
				focusable="false"
			>
				<path d="M0 0h2v1H0zM9 0h2v1H9zM1 1h2v1H1zM8 1h2v1H8zM2 2h2v1H2zM7 2h2v1H7zM3 3h2v1H3zM6 3h2v1H6zM4 4h3v1H4z" />
				<path
					class="scroll-chevron-tail"
					d="M0 6h2v1H0zM9 6h2v1H9zM1 7h2v1H1zM8 7h2v1H8zM2 8h2v1H2zM7 8h2v1H7zM3 9h2v1H3zM6 9h2v1H6zM4 10h3v1H4z"
				/>
			</svg>
		</button>
	)}
</section>

<script>
	// 使用事件委托，让 Swup 替换页面后新出现的按钮也能直接使用。
	document.addEventListener("click", (event) => {
		if (!(event.target instanceof Element)) return;
		const indicator = event.target.closest("#scroll-indicator");
		const banner = indicator?.closest(".hero-banner");
		if (!banner) return;

		window.scrollTo({
			top: window.scrollY + banner.getBoundingClientRect().bottom - 80,
			behavior: window.matchMedia("(prefers-reduced-motion: reduce)").matches
				? "auto"
				: "smooth",
		});
	});
</script>

<style>
	@font-face {
		font-family: "Jacquard 24";
		src: url("../assets/fonts/jacquard-24/jacquard-24-latin.woff2") format("woff2");
		font-style: normal;
		font-weight: 400;
		font-display: swap;
	}

	.hero-banner {
		color: #273c4b;
		position: relative;
		width: 100%;
		height: 100vh;
		min-height: 600px;
		overflow: hidden;
	}

	.hero-content {
		display: grid;
		place-items: center;
		width: 100%;
		height: 100%;
		padding: 2rem 1.25rem;
	}

	.hero-title {
		margin: 0;
		font-family: "Jacquard 24", Georgia, serif;
		font-size: clamp(4.5rem, 15vw, 12rem);
		font-weight: 400;
		line-height: 1.15;
		letter-spacing: 0.02em;
		text-align: center;
		white-space: nowrap;
		text-shadow: 2px 2px 0 rgba(255, 255, 255, 0.9);
	}

	/* 去掉原来的白色卡片，只保留一个像素双箭头，颜色沿用标题的深蓝灰 */
	.hero-scroll-indicator {
		--px: 3px; /* 一个像素格的实际尺寸，保持整数以免边缘发虚 */
		position: absolute;
		bottom: 2rem;
		left: 50%;
		transform: translateX(-50%);
		display: grid;
		place-items: center;
		width: 3.25rem;
		height: 3.25rem;
		padding: 0;
		border: 0;
		border-radius: 0.5rem;
		color: inherit;
		background: transparent;
		cursor: pointer;
		-webkit-tap-highlight-color: transparent;
	}

	.hero-scroll-indicator:focus-visible {
		outline: 2px solid currentColor;
		outline-offset: 2px;
	}

	.scroll-chevrons {
		width: calc(var(--px) * 11);
		height: calc(var(--px) * 11);
		/* 一格宽的白色像素描边，像游戏精灵一样在明暗交错的倒影上都能看清 */
		filter: drop-shadow(var(--px) 0 0 #fff) drop-shadow(calc(var(--px) * -1) 0 0 #fff)
			drop-shadow(0 var(--px) 0 #fff) drop-shadow(0 calc(var(--px) * -1) 0 #fff);
		animation: pixelBob 1.2s infinite;
	}

	.scroll-chevron-tail {
		fill: #7d8f9c;
	}

	/* 两帧上下跳动，类似 RPG 对话框里的“继续”光标 */
	@keyframes pixelBob {
		0% {
			transform: translateY(0);
			animation-timing-function: step-end;
		}
		50% {
			transform: translateY(var(--px));
			animation-timing-function: step-end;
		}
		100% {
			transform: translateY(0);
		}
	}

	/* 悬停/聚焦时停在“按下”那一帧 */
	.hero-scroll-indicator:hover .scroll-chevrons,
	.hero-scroll-indicator:focus-visible .scroll-chevrons {
		animation: none;
		transform: translateY(var(--px));
	}

	@media (max-width: 768px) {
		.hero-scroll-indicator {
			bottom: calc(1.5rem + env(safe-area-inset-bottom, 0px));
		}
	}

	@media (max-width: 640px) {
		.hero-banner {
			height: 100svh;
			min-height: 32rem;
		}

		.hero-content {
			padding: 2rem 1.25rem 8.5rem;
		}

		.hero-title {
			font-size: clamp(6rem, min(32vw, 24svh), 13rem);
			line-height: 1.05;
			letter-spacing: 0.015em;
			white-space: normal;
		}

		.hero-title-part {
			display: block;
			white-space: nowrap;
		}
	}

	@media (max-width: 960px) and (max-height: 480px) {
		.hero-banner {
			height: 100svh;
			min-height: 0;
		}

		.hero-content {
			padding: 1.5rem 1.25rem 5rem;
		}

		.hero-title {
			font-size: clamp(4rem, min(15vw, 32svh), 7rem);
			white-space: nowrap;
		}

		.hero-title-part {
			display: inline;
		}

		.hero-scroll-indicator {
			bottom: calc(0.75rem + env(safe-area-inset-bottom, 0px));
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.scroll-chevrons {
			animation: none;
		}
	}
</style>
