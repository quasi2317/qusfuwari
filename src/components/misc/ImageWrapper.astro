---
import path from "node:path";

interface Props {
	id?: string;
	src: string;
	class?: string;
	alt?: string;
	position?: string;
	basePath?: string;
	width?: number;
	height?: number;
	quality?: number;
	loading?: "lazy" | "eager";
}

import { Image } from "astro:assets";
import { url } from "../../utils/url-utils";

const {
	id,
	src,
	alt,
	position = "center",
	basePath = "/",
	width,
	height,
	quality = 80,
	loading = "lazy",
} = Astro.props;
const className = Astro.props.class;

const isLocal = !(
	src.startsWith("/") ||
	src.startsWith("http") ||
	src.startsWith("https") ||
	src.startsWith("data:")
);
const isPublic = src.startsWith("/");

let img: ImageMetadata | undefined;
if (isLocal) {
	const files = import.meta.glob<ImageMetadata>("../../**/*.{jpg,jpeg,png,gif,webp,avif,svg}", {
		import: "default",
	});
	let normalizedPath = path
		.normalize(path.join("../../", basePath, src))
		.replace(/\\/g, "/");
	const file = files[normalizedPath];
	if (!file) {
		throw new Error(
			`\n[ERROR] Image file not found: ${normalizedPath.replace("../../", "src/")}`,
		);
	}
	img = await file();
}

const imageClass = "w-full h-full object-cover";
const imageStyle = `object-position: ${position}`;
---
<div id={id} class:list={[className, 'overflow-hidden relative']}>
    <div class="transition absolute inset-0 bg-opacity-50 pointer-events-none"></div>
    {isLocal && img && <Image 
		src={img} 
		alt={alt || ""} 
		class={imageClass} 
		style={imageStyle}
		width={width}
		height={height}
		quality={quality}
		loading={loading}
		format="webp"
	/>}
    {!isLocal && <img src={isPublic ? url(src) : src} alt={alt || ""} width={width} height={height} class={imageClass} style={imageStyle} loading={loading} decoding="async"/>}
</div>
